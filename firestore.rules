rules_version = '2';

/**
 * Bachat Bazaar - Firestore Security Rules (Item #1)
 * ====================================================
 * Pehle: koi rules file hi nahi thi -> Firestore default/open state mein
 * thi, matlab koi bhi browser console se seedha data padh/badal sakta tha.
 *
 * Ye pehla step hai. Ye SIRF admin credentials aur admin-only writes ko
 * lock karta hai (server-side verified Firebase Auth ke through).
 * Orders/customers/sellers/products/chat abhi bhi client se likhe ja
 * rahe hain (jaisa pehle tha) - agla item (#2) unhe Netlify Functions ke
 * peeche move karega taaki app abhi na tootey. Neeche har jagah TODO
 * comment se saaf likha hai kya abhi bhi baaki hai.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Sirf Netlify Function (Firebase Admin SDK) is claim ke saath custom
    // token issue karta hai, PASSWORD VERIFY karne ke baad. Client kabhi
    // khud ye claim nahi bana sakta.
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Admin ka username/passwordHash/passwordSalt yahan store hota hai.
    // Ye document sirf server (Admin SDK, jo rules ko bypass karta hai)
    // padh sakta hai. Client SDK se - admin khud bhi - kabhi nahi.
    match /store/admin-secure {
      allow read, write: if false;
    }

    // Public site settings (naam, banner, contact, coupon-display, etc.)
    // Ab admin credentials is doc mein NAHI rahenge (migrate ho jayega
    // admin-secure mein) - baaki fields sabke liye readable rehna zaroori
    // hai kyunki poori app UI isi se banti hai.
    match /store/store-settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store/slider-images {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store/coupons {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TODO (Item #2): sellers mein phone numbers/PII hain - read ko bhi
    // restrict karna hai aur write ko seller-apna-record / admin tak.
    match /store/sellers {
      allow read: if true;
      allow write: if true;
    }

    // TODO (Item #2): products approval sirf admin kare, seller sirf apne
    // products likh paaye - abhi ke liye as-is taaki listing na tootey.
    match /store/products {
      allow read: if true;
      allow write: if true;
    }

    // TODO (Item #2 - Payment/Order Integrity): order status/payment
    // sirf server (Razorpay signature verify karke) update kare, customer
    // sirf apna order bana paaye, dekh paaye.
    match /store/orders {
      allow read: if true;
      allow write: if true;
    }

    // TODO (Item #2): customer PII (password hash sahit) abhi bhi
    // world-readable hai - agla item isse lock karega.
    match /store/customers {
      allow read: if true;
      allow write: if true;
    }

    // TODO (Item #2): chat messages private hone chahiye (sirf buyer,
    // seller, admin) - abhi as-is.
    match /store/chat-messages {
      allow read: if true;
      allow write: if true;
    }

    // Kisi bhi nayi/anjaani doc ke liye default: read khula, write sirf
    // admin - taaki galti se koi naya open-write doc na ban jaaye.
    match /store/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Netlify Functions ka rate-limit counter (_shared/security.js).
    // Sirf Admin SDK (server) padhta/likhta hai - client ke liye poori
    // tarah band, taaki koi apna hi counter reset na kar sake.
    match /rate_limits/{key} {
      allow read, write: if false;
    }

    // Security audit log (login/reset attempts, rate-limit hits, etc.) -
    // sirf Admin SDK likhta hai. Admin panel se dekhne ke liye sirf
    // isAdmin() ko read milta hai, koi bhi client seedha nahi likh sakta.
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
